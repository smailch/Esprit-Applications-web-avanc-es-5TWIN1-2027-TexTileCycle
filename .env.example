APP_NAME=TexTileCycle
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mongodb
MONGODB_URI=mongodb+srv://USER:PASSWORD@textilecycle.tyxmjeh.mongodb.net/?retryWrites=true&w=majority&appName=TexTileCycle
MONGODB_DATABASE=textilecycle
MONGODB_APP_NAME=TexTileCycle
MONGODB_TLS_CA_FILE=

# IP Atlas dynamique (une seule configuration). Project ID : Atlas → Project Settings.
# Clé API : Access Manager → Project Access → API Keys, rôle Project Owner.
ATLAS_IP_SYNC=true
ATLAS_PROJECT_ID=
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=

ADMIN_NAME="Administrateur TexTileCycle"
ADMIN_EMAIL=admin@textilecycle.tn
ADMIN_PASSWORD=ChangeMe123!

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail : MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls.
# MAIL_USERNAME et MAIL_FROM_ADDRESS = l'adresse du compte.
# MAIL_PASSWORD = mot de passe d'application (jamais le mot de passe du compte).
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Analyse photo des vêtements : une seule clé suffit (Gemini par défaut).
VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Clé Gemini propre à chaque développeur pour matching, pré-contrôle et besoins (module Associations & Dons)
GEMINI_DONS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Diagnostic par photo (microservice ia-diagnostic/, voir ia-diagnostic/README.md)
IA_DIAGNOSTIC_URL=http://127.0.0.1:8001
IA_DIAGNOSTIC_JETON=

# WhatsApp Cloud API : message au citoyen quand le cycle se clôt (don ou réparation).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_FROM=
WHATSAPP_PIN=
